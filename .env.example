SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://localhost:5432/gayadi
DB_USERNAME=gayadi
DB_PASSWORD=change-me
SERVER_PORT=8080
ACTUATOR_ENDPOINTS=health,info
DB_POOL_MINIMUM_IDLE=2
DB_POOL_MAXIMUM_SIZE=10
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000
DB_MAX_LIFETIME_MS=1800000

# Groq 기반 API-first Agent 추천을 사용할 때만 설정합니다
APP_AI_ENABLED=false
# Spring AI의 OpenAI 호환 채팅 클라이언트를 Groq에 연결합니다
AI_CHAT_MODEL=openai
AI_LLM_BASE_URL=https://api.groq.com/openai/v1
AI_LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
# JWT (이메일/닉네임 로그인) — 운영에서는 반드시 강한 시크릿으로 교체하세요
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=604800
AUTH_MAXIMUM_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# 운영 API 문서는 필요한 기간에만 열어 주세요
SWAGGER_ENABLED=false

# 한국관광공사 국문 관광정보 서비스(KorService2) — 공공데이터포털에서 발급받은 인증키(Decoding)
TOUR_API_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_MOBILE_APP=Gayadi
TOUR_API_CONNECT_TIMEOUT=5s
TOUR_API_REQUEST_TIMEOUT=10s

# 한국관광공사 관광지 집중률 방문자 추이 예측 정보 — 별도 활용신청 필요, 향후 30일 예측
# 미설정 시 TOUR_API_KEY를 사용하며, 권한/자료가 없으면 낮은 신뢰도의 달력 추정값으로 대체합니다
CONGESTION_API_KEY=
CONGESTION_API_BASE_URL=https://apis.data.go.kr/B551011/TatsCnctrRateService
CONGESTION_API_MOBILE_APP=Gayadi
CONGESTION_API_CONNECT_TIMEOUT=5s
CONGESTION_API_REQUEST_TIMEOUT=10s
CONGESTION_CACHE_TTL=30m
CONGESTION_MAXIMUM_CACHE_ENTRIES=512

# 기상청 단기예보 조회서비스 — 별도 키가 없다면 하위 호환을 위해 TOUR_API_KEY로 대체합니다
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
WEATHER_API_CONNECT_TIMEOUT=5s
WEATHER_API_REQUEST_TIMEOUT=10s
WEATHER_API_PAGE_SIZE=1000
WEATHER_API_MAXIMUM_PAGES=20

# TMAP 대중교통 — ROUTE_PROVIDER=tmap일 때만 사용합니다
ROUTE_PROVIDER=local
SKT_APPKEY=
TRANSIT_API_BASE_URL=https://apis.openapi.sk.com/transit/routes
TMAP_FALLBACK_TO_LOCAL=true
TMAP_CONNECT_TIMEOUT=5s
TMAP_REQUEST_TIMEOUT=15s
TMAP_MAXIMUM_RESULTS=10
