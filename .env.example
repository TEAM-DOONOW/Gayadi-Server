# =========================================================
# Spring
# =========================================================

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

H2_CONSOLE_ENABLED=false
ACTUATOR_ENDPOINTS=health,info


# =========================================================
# PostgreSQL
# =========================================================

# 같은 Docker external network의 PostgreSQL 컨테이너로 연결
DB_URL=jdbc:postgresql://localhost:5432/gayadi
DB_USERNAME=gayadi

# DB_PASSWORD는 secret으로 관리 (./secrets/db_password)
# DB_PASSWORD=change-me


# =========================================================
# Redis
# =========================================================

REDIS_HOST=gayadi-redis
REDIS_PORT=6379
REDIS_USERNAME=gayadi

REDIS_SSL_ENABLED=false
REDIS_CONNECT_TIMEOUT=2s
REDIS_READ_TIMEOUT=2s

SECURITY_REDIS_ENABLED=true
SECURITY_REDIS_KEY_PREFIX=gayadi:prod:security
SECURITY_REDIS_MAX_TTL=90d

# REDIS_PASSWORD는 secret으로 관리 (./secrets/redis_password)
# REDIS_PASSWORD=change-me


# =========================================================
# AI / Groq
# Groq 기반 API-first Agent 추천을 사용할 때만 설정합니다
# =========================================================

APP_AI_ENABLED=false

# Spring AI의 OpenAI 호환 채팅 클라이언트를 Groq에 연결합니다
AI_CHAT_MODEL=openai
AI_LLM_BASE_URL=https://api.groq.com/openai/v1
AI_LLM_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY는 secret으로 관리 (./secrets/groq_api_key)
# GROQ_API_KEY=

# API-first 모드에서는 임베딩을 사용하지 않습니다
APP_AI_EMBEDDING_ENABLED=false
AI_EMBEDDING_MODEL=none
AI_VECTOR_STORE_FILE=.data/place-vectors.json


# =========================================================
# Firebase
# Firebase (Firestore + FCM) — 비활성 시 PostgreSQL만 사용합니다
# =========================================================

FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=

# Firebase를 사용할 경우 service account JSON 자체를 Docker secret으로 mount하는 것을 권장
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=


# =========================================================
# Google OAUTH
# =========================================================

GOOGLE_CLIENT_ID=exmaple.apps.googleusercontent.com


# =========================================================
# JWT
# JWT (이메일/닉네임 로그인) — 운영에서는 반드시 강한 시크릿으로 교체하세요
# =========================================================

JWT_EXPIRES_IN_SECONDS=604800

# JWT_SECRET은 secret으로 관리 (./secrets/jwt_secret)
# JWT_SECRET=change-me-to-a-long-random-secret

# =========================================================
# Swagger / Admin
# 운영 API 문서는 필요한 기간에만 열어 주세요
# =========================================================

SWAGGER_ENABLED=false
ADMIN_USER_ID=0


# =========================================================
# 한국관광공사 KorService2
# 한국관광공사 국문 관광정보 서비스(KorService2) — 공공데이터포털에서 발급받은 인증키(Decoding)
# =========================================================

TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_MOBILE_APP=Gayadi

# TOUR_API_KEY는 secret으로 관리 (./secrets/tour_api_key)
# TOUR_API_KEY=


# =========================================================
# 관광지 집중률 / 혼잡도
# 한국관광공사 관광지 집중률 방문자 추이 예측 정보 — 별도 활용신청 필요, 향후 30일 예측
# =========================================================

CONGESTION_API_BASE_URL=https://apis.data.go.kr/B551011/TatsCnctrRateService
CONGESTION_API_MOBILE_APP=Gayadi

# CONGESTION_API_KEY는 secret으로 관리 (./secrets/congestion_api_key)
# CONGESTION_API_KEY=


# =========================================================
# 기상청
# 기상청 단기예보 조회서비스
# =========================================================

WEATHER_API_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0

# WEATHER_API_KEY는 secret으로 관리 (./secrets/weather_api_key)
# WEATHER_API_KEY=


# =========================================================
# TMAP / 대중교통
# TMAP 대중교통 — ROUTE_PROVIDER=tmap일 때만 사용합니다
# =========================================================

ROUTE_PROVIDER=local

# SKT_APPKEY는 secret으로 관리 (./secrets/skt_appkey)
# SKT_APPKEY=

TRANSIT_API_BASE_URL=https://apis.openapi.sk.com/transit/routes
TMAP_FALLBACK_TO_LOCAL=true