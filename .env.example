SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://localhost:5432/gayadi
DB_USERNAME=gayadi
DB_PASSWORD=change-me
SERVER_PORT=8080
H2_CONSOLE_ENABLED=false
ACTUATOR_ENDPOINTS=health,info

# 선택 기능인 장소 추천을 사용할 때만 설정합니다
APP_AI_ENABLED=false
AI_CHAT_MODEL=none
AI_EMBEDDING_MODEL=none
OPENAI_API_KEY=sk-...
AI_VECTOR_STORE_FILE=.data/place-vectors.json

# Firebase (Firestore + FCM) — 비활성 시 PostgreSQL만 사용합니다
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

# JWT (이메일/닉네임 로그인) — 운영에서는 반드시 강한 시크릿으로 교체하세요
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=604800

# 운영 API 문서는 필요한 기간에만 열어 주세요
SWAGGER_ENABLED=false
ADMIN_USER_ID=0

# 한국관광공사 국문 관광정보 서비스(KorService2) — 공공데이터포털에서 발급받은 인증키(Decoding)
# 기상청 단기예보 조회서비스(VilageFcstInfoService_2.0)도 동일한 인증키(TOUR_API_KEY) 사용
TOUR_API_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_MOBILE_APP=Gayadi

# 기상청 단기예보 조회서비스 — TOUR_API_KEY 인증키 공용
WEATHER_API_BASE_URL=http://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
